# Environment Configuration for Simpson Strong-Tie Expert MCP

ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL 18 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=simpson_mcp
POSTGRES_USER=simpson
POSTGRES_PASSWORD=simpson_dev_password
DATABASE_URL=postgresql+asyncpg://simpson:simpson_dev_password@localhost:5432/simpson_mcp

# Object Storage Configuration (Local Filesystem or MinIO)
STORAGE_ADAPTER=filesystem
STORAGE_LOCAL_ROOT=./data/storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=simpson-evidence

# Applications & Services Configuration
API_PORT=8000
MCP_PORT=8001
ADMIN_WEB_PORT=5173
WORKER_CONCURRENCY=4
